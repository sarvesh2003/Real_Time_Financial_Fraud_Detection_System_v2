# Copy to .env (git-ignored). docker compose reads it from the repository root.
# The supported stack downloads MaxMind GeoLite2 data, which needs a free
# account. For a stack without credentials, leave this file out and use
# EXPERIMENT_STACK_FILE=experiments/fixture_stack.json (record-free GeoIP).
COMPOSE_PROFILES=geoip
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
GEOIPUPDATE_EDITION_IDS=GeoLite2-City GeoLite2-ASN
GEOIPUPDATE_FREQUENCY=24
